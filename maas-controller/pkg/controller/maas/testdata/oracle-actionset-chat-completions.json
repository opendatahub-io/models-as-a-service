    },
    {
      "service": "ratelimit-check-service",
      "scope": "ai-tenant-site-a/qwen3-kserve-route",
      "sources": ["tokenratelimitpolicy.kuadrant.io:ai-tenant-site-a/maas-trlp-qwen3"],
      "conditionalData": [
